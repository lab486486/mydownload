---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FolderTabs from '../components/FolderTabs.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  folder?: string;
}

const {
  title,
  description = site.description,
  canonical,
  image,
  noindex = false,
  folder,
} = Astro.props;

const pageTitle = title ? `${title} - ${site.name}` : `${site.name} 자료실`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={new URL(image, site.url).href} />}
  </head>
  <body>
    <Header />
    <main class="desk">
      <div class="wrap cabinet">
        {!noindex && (
          <div class="tab-rail">
            <FolderTabs current={folder} />
          </div>
        )}
        <div class="cabinet-well">
          <slot />
        </div>
      </div>
    </main>
    <Footer />
    {!noindex && (
      <script is:inline>
        window.adsbygoogle = window.adsbygoogle || [];
        window.addEventListener('load', () => {
          const script = document.createElement('script');
          script.async = true;
          script.src =
            'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8094444885520451';
          script.crossOrigin = 'anonymous';
          document.body.appendChild(script);
        });
      </script>
    )}
  </body>
</html>
