---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import ExplorerWindow from '../components/ExplorerWindow.astro';
import { categories } from '../lib/categories';
import { getListedSoftware } from '../lib/software';

const listed = await getListedSoftware();
const counts = Object.fromEntries(
  categories.map((category) => [
    category.slug,
    listed.filter((entry) => entry.data.category === category.slug).length,
  ]),
);
---

<Base title="자료 검색" description="마이 다운로드 자료실에서 프로그램을 찾습니다." folder="all">
  <section class="hero">
    <p class="kicker">Search / Find File</p>
    <h1 class="page-title">자료 검색</h1>
    <SearchBox />
  </section>
  <section class="section">
    <p id="search-status" class="muted">검색어를 입력하면 이름, 설명, 태그에서 찾습니다.</p>
    <div style="margin-top: 16px;">
      <ExplorerWindow
        title="검색 결과"
        path="마이 다운로드 \\ 검색"
        current="all"
        entries={[]}
        counts={counts}
        total={listed.length}
        bodyId="search-results"
        stamp="QUERY"
      />
    </div>
  </section>
</Base>

<script>
  import Fuse from 'fuse.js';

  type Item = {
    name: string;
    title: string;
    excerpt: string;
    href: string;
    category: string;
    os: string;
    developer: string;
    date: string;
    icon?: string;
    tags: string[];
  };

  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');
  const params = new URLSearchParams(window.location.search);
  const query = params.get('q')?.trim() ?? '';
  const input = document.querySelector<HTMLInputElement>('#q');
  if (input && query) input.value = query;

  function row(item: Item) {
    const icon = item.icon
      ? `<img class="file-icon" src="${item.icon}" alt="" width="20" height="20" loading="lazy" decoding="async" />`
      : `<span class="file-icon fallback">${item.name.slice(0, 1)}</span>`;
    return `<tr>
      <td class="col-name">
        <a class="file-link" href="${item.href}">${icon}<span class="file-name">${item.name}</span></a>
      </td>
      <td class="col-kind">${item.category}</td>
      <td class="col-os">${item.os}</td>
      <td class="col-dev">${item.developer}</td>
      <td class="col-date">${item.date}</td>
    </tr>`;
  }

  const index = await fetch('/search-index.json').then((response) => response.json()) as Item[];
  const fuse = new Fuse(index, {
    threshold: 0.35,
    keys: ['name', 'title', 'excerpt', 'tags', 'category'],
  });

  if (query && status && results) {
    const matches = fuse.search(query).map((item) => item.item);
    status.textContent = matches.length
      ? `"${query}" 검색 결과 ${matches.length}개`
      : `"${query}"에 해당하는 자료가 없습니다.`;
    results.innerHTML = matches.map(row).join('');
  }
</script>
