---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import { categories, categoryPath } from '../lib/categories';
import { getFeaturedSoftware, getListedSoftware } from '../lib/software';
import { driverLinks, officialStores, popularQueries, site } from '../data/site';

const listed = await getListedSoftware();
const featured = await getFeaturedSoftware();
const counts = Object.fromEntries(
  categories.map((category) => [
    category.slug,
    listed.filter((entry) => entry.data.category === category.slug).length,
  ]),
);
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">Software Archive</p>
      <h1>필요한 프로그램을<br />공식 경로로 받는 자료실</h1>
      <p class="lede">{site.tagline}. 설치 파일은 직접 받지 않고, 제작사 페이지로 안내합니다.</p>
      <SearchBox autofocus />
      <div class="chips">
        {popularQueries.map((item) => (
          <a class="chip" href={`/search/?q=${encodeURIComponent(item.query)}`}>{item.label}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>카테고리</h2>
        <p>자료 {listed.length}개</p>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a class="category-card" href={categoryPath(category.slug)}>
            <strong>{category.name}</strong>
            <span>{category.description} · {counts[category.slug]}개</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>최근 자료</h2>
        <a href="/category/utility/">전체 보기</a>
      </div>
      <div class="card-grid">
        {featured.map((entry) => (
          <SoftwareCard entry={entry} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>공식 다운로드 스토어</h2>
      </div>
      <div class="chips" style="margin-bottom: 28px;">
        {officialStores.map((store) => (
          <a class="chip" href={store.href} rel="noopener noreferrer" target="_blank">{store.name}</a>
        ))}
      </div>
      <div class="resource-grid">
        <div class="panel resource-card">
          <h3>PC 부품 드라이버</h3>
          <ul>
            {driverLinks.hardware.map((link) => (
              <li><a href={link.href} rel="noopener noreferrer" target="_blank">{link.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="panel resource-card">
          <h3>프린터 공식 드라이버</h3>
          <ul>
            {driverLinks.printer.map((link) => (
              <li><a href={link.href} rel="noopener noreferrer" target="_blank">{link.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="panel resource-card">
          <h3>개발자 자료실</h3>
          <ul>
            {driverLinks.developer.map((link) => (
              <li><a href={link.href} rel="noopener noreferrer" target="_blank">{link.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>
