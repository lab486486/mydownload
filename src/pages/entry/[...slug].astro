---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleIntro from '../../components/ArticleIntro.astro';
import SpecTable from '../../components/SpecTable.astro';
import AdSlot from '../../components/AdSlot.astro';
import RelatedFolder from '../../components/RelatedFolder.astro';
import DownloadBar from '../../components/DownloadBar.astro';
import FaqEnhance from '../../components/FaqEnhance.astro';
import { getCategory } from '../../lib/categories';
import {
  entryPath,
  getRelatedSoftware,
  getSoftware,
} from '../../lib/software';

export async function getStaticPaths() {
  const entries = await getSoftware();
  return entries.map((entry) => ({
    params: { slug: entry.data.entrySlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = await getRelatedSoftware(entry);
const category = getCategory(entry.data.category);
const canonical = entry.data.canonical ?? entryPath(entry);
const hideFirstImage = Boolean(entry.data.icon) && /^\s*!\[/.test(entry.body);
---

<Base
  title={entry.data.title}
  description={entry.data.excerpt ?? entry.data.title}
  canonical={canonical}
  image={entry.data.icon}
  folder={entry.data.category}
>
  <div class="entry-layout">
    <article class:list={['entry-article', { 'has-cover': hideFirstImage }]}>
      <p class="breadcrumb">
        <a href="/">자료실</a>
        {category && (
          <>
            / <a href={`/category/${category.slug}/`}>{category.name}</a>
          </>
        )}
        / {entry.data.name}
      </p>
      <h1 class="page-title">{entry.data.title}</h1>
      {entry.data.excerpt && <p class="lede">{entry.data.excerpt}</p>}
      <SpecTable entry={entry} />
      <div class="ad-inarticle">
        <AdSlot adSlot="5384795752" label="본문 중간" />
      </div>
      <ArticleIntro entry={entry} />
      <div class="prose">
        <Content />
      </div>
    </article>
    <RelatedFolder
      title={category?.name ?? '관련 자료'}
      slug={category?.slug}
      entries={related}
    />
  </div>

  <DownloadBar entry={entry} />
  <FaqEnhance />
</Base>
