---
interface Props {
  adSlot: string;
  label: string;
  minHeight?: number;
}

const { adSlot, label, minHeight = 280 } = Astro.props;
---

<div class="ad-slot" data-label={label} style={`min-height:${minHeight}px`}>
  <ins
    class="adsbygoogle"
    style={`display:block;min-height:${minHeight}px`}
    data-ad-client="ca-pub-8094444885520451"
    data-ad-slot={adSlot}
    data-ad-format="auto"
    data-full-width-responsive="false"></ins>
</div>
<script is:inline>
  (window.adsbygoogle = window.adsbygoogle || []).push({});
</script>
