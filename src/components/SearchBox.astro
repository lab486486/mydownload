---
interface Props {
  value?: string;
  autofocus?: boolean;
  compact?: boolean;
}

const { value = '', autofocus = false, compact = false } = Astro.props;
---

<form class:list={['search-form', { 'is-compact': compact }]} action="/search/" method="get">
  <label class="visually-hidden" for={compact ? 'q-compact' : 'q'}>프로그램 검색</label>
  <input
    id={compact ? 'q-compact' : 'q'}
    type="search"
    name="q"
    value={value}
    placeholder={compact ? '이 폴더에서 검색' : '프로그램 이름을 입력하세요'}
    required
    autofocus={autofocus}
  />
  <button type="submit">
    {compact ? (
      '찾기'
    ) : (
      <>
        <span class="search-label-full">자료 검색</span>
        <span class="search-label-short">검색</span>
      </>
    )}
  </button>
</form>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
