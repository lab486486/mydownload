---
import {
  categoryLabel,
  entryPath,
  fileDate,
  osList,
  type SoftwareEntry,
} from '../lib/software';

interface Props {
  entries: SoftwareEntry[];
  bodyId?: string;
  emptyText?: string;
}

const { entries, bodyId, emptyText = '이 폴더가 비어 있습니다.' } = Astro.props;
---

<div class="explorer-pane">
  <table class="explorer-table">
    <thead>
      <tr>
        <th class="col-name">이름</th>
        <th class="col-kind">종류</th>
        <th class="col-os">OS</th>
        <th class="col-dev">개발사</th>
        <th class="col-date">등록</th>
      </tr>
    </thead>
    <tbody id={bodyId}>
      {entries.map((entry) => (
        <tr>
          <td class="col-name">
            <a class="file-link" href={entryPath(entry)}>
              {entry.data.icon ? (
                <img class="file-icon" src={entry.data.icon} alt="" width="20" height="20" />
              ) : (
                <span class="file-icon fallback">{entry.data.name.slice(0, 1)}</span>
              )}
              <span class="file-name">{entry.data.name}</span>
            </a>
          </td>
          <td class="col-kind">{categoryLabel(entry)}</td>
          <td class="col-os">{osList(entry)}</td>
          <td class="col-dev">{entry.data.developer ?? '—'}</td>
          <td class="col-date">{fileDate(entry)}</td>
        </tr>
      ))}
    </tbody>
  </table>
  {entries.length === 0 && !bodyId && <p class="empty">{emptyText}</p>}
</div>
